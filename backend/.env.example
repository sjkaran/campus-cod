# Copy to .env (never commit .env)
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:yourpassword@localhost:5432/smart_campus
# On Railway: do NOT set DATABASE_URL in .env. Instead, set it as a Railway environment variable
# in the Railway dashboard using Railway's variable reference syntax, e.g.:
# DATABASE_URL = postgresql+psycopg://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
# Railway injects DATABASE_URL at runtime from the dashboard config, not from this file.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:8080,http://localhost:5173,http://127.0.0.1:5173
TIMEZONE=Asia/Kolkata
LOW_ATTENDANCE_THRESHOLD=75
LOG_LEVEL=INFO