# Copy to .env (never commit .env)
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:karan555@localhost:5432/smart_campus
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated list of allowed browser origins (Student web app)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:8080
TIMEZONE=Asia/Kolkata
LOW_ATTENDANCE_THRESHOLD=75
LOG_LEVEL=INFO
